# Alpaca Trading Configuration (paper keys from https://app.alpaca.markets -> Paper Trading)
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
# Paper unless this is exactly "false". Live keys + ALPACA_PAPER=false = real money.
ALPACA_PAPER=true

# Anthropic LLM API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Members to mirror (Tracefour slugs, comma-separated). Defaults to the five in the spec.
# TARGET_MEMBERS=nancy-pelosi,marjorie-taylor-greene,ro-khanna,michael-mccaul,sheldon-whitehouse

# Optional Tracefour key ("tf_...", https://tracefour.com/settings). Anonymous tier is 60 requests/hour,
# enough for the hourly pipeline but not for the Senate family sweep.
# TRACEFOUR_API_KEY=

# House trades for every member are shown; set true to also mirror members outside TARGET_MEMBERS.
# CONGRESS_MIRROR_ALL_MEMBERS=false

# Disclosure sources to ingest (all default to true)
# ENABLE_CONGRESS=true
# ENABLE_INSIDERS=true
# ENABLE_EXECUTIVE=true

# Database Storage Path
DB_PATH=data/ledger.db
